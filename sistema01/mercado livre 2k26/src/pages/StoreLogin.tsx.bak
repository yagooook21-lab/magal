    `;
  };

  const getPasswordHTML = (email: string) => {
    const maskedEmail = email.replace(/(.{2})(.*)(@.*)/, (_, a, b, c) => a + '*'.repeat(b.length) + c);
    return `
      ${getCommonHeader()}
      <main role="main" id="root-app" data-navigation="true">
        <div id="_R_32e_" style="display:contents">
            <div class="grid-view__container">
                <div class="grid-view__main">
                    <div class="grid-view__section--headers">
