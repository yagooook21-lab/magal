                                    <div class="andes-list__item-first-column" id="_R_c8r2e_-0-content">
                                        <div class="andes-list__item-asset andes-list__item-asset--icon andes-list__item-asset--icon-one-line"
                                            aria-hidden="true" data-andes-list-left-content="true"><svg
