    background-image: url(https://http2.mlstatic.com/frontend-assets/ml-web-navigation/ui-navigation/7.19.0/mercadolibre/pt_logo_large_plus@2x.webp) !important;
">Mercado Livre Brasil - Onde comprar e vender de Tudo</a>
        </div>
    </header>
  `;

  const getCommonFooter = () => `
    <footer class="login-footer login-footer--landscape">
