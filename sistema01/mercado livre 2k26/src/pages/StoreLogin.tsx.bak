                                                data-andes-button-hierarchy="mute" data-andes-button-size="large"><span
                                                    class="andes-button__content" data-andes-button-content="true">Criar
                                                    conta</span></a>` : ''}
                                            <div class="login-form__challenge-divider">
                                                <hr class="login-form__divider" aria-hidden="true">
                                                <p class="login-form__o">ou</p>
                                                <hr class="login-form__divider" aria-hidden="true">
                                            </div>
                                            <div id="login-form__oauth-container">
                                                <div class="google-button">
                                                    <div class="S9gUrf-YoZ4jf" style="position: relative;">
                                                        <div></div><iframe
                                                            src="https://accounts.google.com/gsi/button?type=standard&amp;theme=outline&amp;size=large&amp;text=signin_with&amp;shape=rectangular&amp;logo_alignment=left&amp;width=398&amp;client_id=1055017050086-8dk183v50lmf3bjmnddfv4grt1ldn9b6.apps.googleusercontent.com&amp;hl=pt"
                                                            class="L5Fo6c-PQbLGe" allow="identity-credentials-get"
                                                            title="Botão Iniciar sessão com o Google"
                                                            style="display: block; position: relative; top: 0px; left: 0px; height: 44px; width: 418px; border: 0px; margin: -2px -10px;"></iframe>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
