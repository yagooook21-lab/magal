                        <h1
                            class="andes-ui-typography grid-view__title andes-ui-typography--type-heading andes-ui-typography--size-xhuge andes-ui-typography--color-primary andes-ui-typography--weight-default andes-ui-typography-heading-xhuge-default">
                            ${isRegister ? "Agora, crie a sua senha" : "Agora, digite a sua senha"}</h1>
                    </div>
                    <div class="user-pill" style="margin-bottom: 24px; display: flex; align-items: center; padding: 12px; background: #f5f5f5; border-radius: 6px;">
                        <div class="andes-ui-thumbnail__container andes-ui-thumbnail__container--small" data-andes-thumbnail="true">
                          <div class="andes-ui-thumbnail andes-ui-thumbnail--circle andes-ui-thumbnail--small andes-ui-thumbnail__icon andes-ui-thumbnail--quiet user-pill__avatar" style="margin-right:12px;"><svg aria-hidden="true" color="accent" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M11.999 15.75C15.7275 15.75 18.75 12.7275 18.75 8.999C18.75 5.27053 15.7275 2.248 11.999 2.248C8.27053 2.248 5.248 5.27053 5.248 8.999C5.248 12.7275 8.27053 15.75 11.999 15.75ZM11.999 14.25C9.09895 14.25 6.748 11.899 6.748 8.999C6.748 6.09895 9.09895 3.748 11.999 3.748C14.899 3.748 17.25 6.09895 17.25 8.999C17.25 11.899 14.899 14.25 11.999 14.25Z" fill="currentColor"></path>
                            <path d="M5.98045 18.75C4.74861 18.75 3.75 19.7486 3.75 20.9804V21.7304H2.25V20.9804C2.25 18.9202 3.92018 17.25 5.98045 17.25H18C20.0711 17.25 21.75 18.9289 21.75 21V21.75H20.25V21C20.25 19.7574 19.2426 18.75 18 18.75H5.98045Z" fill="currentColor"></path>
                          </svg></div>
                        </div>
                        <div class="user-pill__body">
                          <p class="user-pill__identifier" style="font-size: 14px; font-weight: 600; margin: 0;">${maskedEmail}</p>
                          <button class="andes-ui-typography user-pill__change-user-link" id="back-to-email-link" type="button" style="background: none; border: none; padding: 0; color: #3483fa; font-size: 12px; cursor: pointer;">Alterar e-mail</button>
                        </div>
                    </div>
                    <div class="andes-card grid-view__section--content andes-card--outline andes-card--primary andes-card--padding-0"
                        id="_R_58r2e_" data-andes-card="true" data-andes-card-hierarchy="primary">
                        <div class="andes-card__overlap">
                            <div class="andes-card__content" data-andes-card-content="true">
                                <div class="children-wrapper">
                                    <form class="login-form login-form--social" novalidate="" id="login_password_form">
                                        <div class="login-form__input">
                                          <div class="andes-form-control andes-form-control--textfield andes-form-control--default" data-andes-textfield="true">
                                            <label for="password"><span class="andes-form-control__label">Senha</span></label>
                                            <div class="andes-form-control__control" style="position: relative; border-radius: 6px; border: 1px solid rgba(0,0,0,0.25); background: #fff;">
                                              <input type="password" id="password" class="andes-form-control__field" name="password" autofocus="" autocomplete="current-password" style="padding: 13px 12px; font-size: 16px; border: none; width: 100%; outline: none; background: transparent;">
                                              <div id="password-icon-container" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #3483fa;">
                                                <input class="andes-ui-textfield__password-checkbox" id="password-checkbox" type="checkbox" style="display:none">
                                                <svg class="eye-closed-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M2.76108 8.80639C3.10268 8.62194 3.52411 8.73023 3.73764 9.04467L3.77768 9.1101L3.95053 9.42065C4.83847 10.9675 6.05 12.3958 7.41635 13.4519C8.87779 14.5814 10.468 15.2496 11.9994 15.2497C13.5309 15.2497 15.1218 14.5814 16.5833 13.4519C18.0407 12.3256 19.3217 10.7761 20.222 9.11108C20.419 8.74683 20.8743 8.61062 21.2386 8.80737C21.6028 9.00436 21.7381 9.45969 21.5414 9.82397C20.7121 11.3575 19.5875 12.8082 18.2845 13.9822L19.5746 15.5173L19.6214 15.5789C19.8348 15.893 19.7797 16.3243 19.4828 16.574C19.1855 16.8237 18.7505 16.8036 18.4779 16.5388L18.4261 16.4822L17.1165 14.9226C15.7866 15.8725 14.2961 16.5407 12.7503 16.7078V18.9997C12.7503 19.4139 12.4144 19.7496 12.0003 19.7497C11.5861 19.7497 11.2503 19.414 11.2503 18.9997V16.7078C9.70444 16.541 8.21324 15.8736 6.88315 14.9236L5.57455 16.4822C5.30817 16.7993 4.83508 16.8403 4.51791 16.574C4.20088 16.3075 4.15974 15.8344 4.42612 15.5173L5.7142 13.9822C4.50889 12.8958 3.45607 11.5725 2.64877 10.1658L2.45737 9.82299L2.42514 9.75365C2.27929 9.40285 2.41977 8.99109 2.76108 8.80639Z" fill="currentColor"></path></svg>
                                                <svg class="eye-open-icon" style="display:none" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.34905 9.34863C10.8135 7.88448 13.1874 7.88427 14.6518 9.34863L14.7846 9.48828C16.1146 10.9602 16.0702 13.2326 14.6518 14.6514C13.1874 16.1158 10.8135 16.1157 9.34905 14.6514C7.88458 13.1869 7.88458 10.8131 9.34905 9.34863ZM13.4203 10.2549C12.5367 9.53414 11.2334 9.58571 10.4096 10.4092C9.53092 11.2879 9.53092 12.7121 10.4096 13.5908C11.2883 14.4694 12.7126 14.4695 13.5912 13.5908C14.4147 12.7671 14.4662 11.4637 13.7455 10.5801L13.5912 10.4092L13.4203 10.2549Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M12.0004 4.25C13.9637 4.2501 15.8689 5.09861 17.5014 6.36035C19.0357 7.54627 20.3728 9.12946 21.351 10.834L21.5424 11.1768L21.6332 11.374C21.8149 11.8437 21.7847 12.3752 21.5424 12.8242L21.5414 12.8252C20.5499 14.6586 19.1378 16.3749 17.5014 17.6396C15.8689 18.9012 13.9637 19.7499 12.0004 19.75C10.0371 19.75 8.132 18.9014 6.49944 17.6396C4.96496 16.4537 3.62708 14.8707 2.64885 13.166L2.45842 12.8232C2.1815 12.31 2.1815 11.689 2.45842 11.1758C3.44997 9.34218 4.86285 7.62511 6.49944 6.36035C8.132 5.09872 10.0371 4.25 12.0004 4.25ZM12.0004 5.75C10.4688 5.75 8.87805 6.41736 7.41643 7.54688C5.95889 8.67327 4.6782 10.2234 3.77776 11.8887C3.74112 11.9571 3.74111 12.0419 3.77776 12.1104L3.95158 12.4209C4.8395 13.9677 6.05013 15.3961 7.41643 16.4521C8.87805 17.5818 10.4688 18.25 12.0004 18.25C13.5318 18.2499 15.122 17.5824 16.5834 16.4531C18.0409 15.3268 19.3217 13.7765 20.2221 12.1113C20.2588 12.0428 20.2588 11.9581 20.2221 11.8896C19.3217 10.224 18.0409 8.67432 16.5834 7.54785C15.1219 6.41825 13.5319 5.7501 12.0004 5.75Z" fill="currentColor"></path></svg>
                                              </div>
                                            </div>
                                          </div>
                                        </div>
                                        <div class="login-form__actions login-form__actions--social">
                                          <button type="submit"
                                                class="andes-button login-form__submit login-form__submit--social andes-button--large andes-button--loud"
                                                id="login_password_submit" data-andes-button="true"
                                                data-andes-button-hierarchy="loud" data-andes-button-size="large"><span
                                                    class="andes-button__content"
                                                    data-andes-button-content="true">Confirmar</span></button>
                                          <a class="andes-button andes-button--large andes-button--mute andes-button--full-width"
                                                id="choose-other-method" data-andes-button="true"
                                                data-andes-button-hierarchy="mute" data-andes-button-size="large"><span
