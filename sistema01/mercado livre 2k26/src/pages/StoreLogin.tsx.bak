                            class="andes-ui-typography grid-view__title andes-ui-typography--type-heading andes-ui-typography--size-xhuge andes-ui-typography--color-primary andes-ui-typography--weight-default andes-ui-typography-heading-xhuge-default">
                            ${isRegister ? "Crie a sua conta" : "Digite seu e-mail ou telefone para iniciar sessão"}</h1>
                    </div>
                    <div class="grid-view__section--help">
                        <div class="grid-view__help-section">
                            <ul class="andes-list security-problem security-problem-social andes-list--default andes-list--selectable"
                                id="_R_c8r2e_" data-andes-list="true">
                                <li class="andes-list__item andes-list__item--size-small andes-list__item--selectable"
                                    id="_R_c8r2e_-0" data-andes-list-item="true" data-andes-list-item-size="small"><a
